{
  "name": "foodtruck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-concurrency=1 --test-timeout=60000 tests/starter.test.js",
    "test:acceptance": "node --test --test-concurrency=1 --test-timeout=60000 tests/*.acceptance.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "swagger-ui-express": "^5.0.1"
  }
}
